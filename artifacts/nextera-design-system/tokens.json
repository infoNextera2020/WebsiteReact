{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens extracted from the Nextera Education website. Edit values here only; generated CSS and token exports are rebuilt with pnpm tokens. The system uses warm paper surfaces, dark evergreen ink, a lime-green action color, and a three-part type system.",
  "color": {
    "$type": "color",
    "light": {
      "background": {
        "$value": "#f9f8f5",
        "$description": "Warm paper background for the main page canvas."
      },
      "foreground": {
        "$value": "#1a1e1c",
        "$description": "Evergreen-black default text."
      },
      "border": {
        "$value": "#d8d6d0",
        "$description": "Quiet warm border used for separators and outlined surfaces."
      },
      "card": {
        "$value": "#ffffff",
        "$description": "Raised light surface for content cards."
      },
      "cardForeground": { "$value": "#1a1e1c" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#1a1e1c" },
      "primary": {
        "$value": "#93d75b",
        "$description": "Nextera lime. Use for primary actions, active states, and key emphasis."
      },
      "primaryForeground": { "$value": "#131614" },
      "secondary": {
        "$value": "#e9e7e2",
        "$description": "Warm neutral supporting surface."
      },
      "secondaryForeground": { "$value": "#1a1e1c" },
      "muted": { "$value": "#eeede7" },
      "mutedForeground": {
        "$value": "#616b66",
        "$description": "Secondary copy and metadata on light surfaces."
      },
      "accent": { "$value": "#93d75b" },
      "accentForeground": { "$value": "#131614" },
      "destructive": { "$value": "#dc4038" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d8d6d0" },
      "ring": { "$value": "#93d75b" },
      "chart1": { "$value": "#93d75b" },
      "chart2": { "$value": "#3f8f72" },
      "chart3": { "$value": "#1a1e1c" },
      "chart4": { "$value": "#e3a84b" },
      "chart5": { "$value": "#dc4038" },
      "sidebar": { "$value": "#f9f8f5" },
      "sidebarForeground": { "$value": "#1a1e1c" },
      "sidebarBorder": { "$value": "#d8d6d0" },
      "sidebarPrimary": { "$value": "#131614" },
      "sidebarPrimaryForeground": { "$value": "#f9f8f5" },
      "sidebarAccent": { "$value": "#eeede7" },
      "sidebarAccentForeground": { "$value": "#1a1e1c" },
      "sidebarRing": { "$value": "#93d75b" }
    },
    "dark": {
      "background": {
        "$value": "#101412",
        "$description": "Deep evergreen ink canvas used for the dark theme."
      },
      "foreground": { "$value": "#f9f8f5" },
      "border": { "$value": "#373f3b" },
      "card": { "$value": "#1c211f" },
      "cardForeground": { "$value": "#f9f8f5" },
      "popover": { "$value": "#1c211f" },
      "popoverForeground": { "$value": "#f9f8f5" },
      "primary": {
        "$value": "#93d75b",
        "$description": "Lime remains the action color in dark mode."
      },
      "primaryForeground": { "$value": "#101412" },
      "secondary": { "$value": "#282e2b" },
      "secondaryForeground": { "$value": "#f9f8f5" },
      "muted": { "$value": "#262c29" },
      "mutedForeground": { "$value": "#afaca1" },
      "accent": { "$value": "#93d75b" },
      "accentForeground": { "$value": "#101412" },
      "destructive": { "$value": "#a62f2a" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#373f3b" },
      "ring": { "$value": "#93d75b" },
      "chart1": { "$value": "#93d75b" },
      "chart2": { "$value": "#55b68d" },
      "chart3": { "$value": "#f0d36a" },
      "chart4": { "$value": "#e3a84b" },
      "chart5": { "$value": "#e87368" },
      "sidebar": { "$value": "#1e2421" },
      "sidebarForeground": { "$value": "#f9f8f5" },
      "sidebarBorder": { "$value": "#373f3b" },
      "sidebarPrimary": { "$value": "#93d75b" },
      "sidebarPrimaryForeground": { "$value": "#101412" },
      "sidebarAccent": { "$value": "#282e2b" },
      "sidebarAccentForeground": { "$value": "#f9f8f5" },
      "sidebarRing": { "$value": "#93d75b" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Manrope", "sans-serif"],
        "$description": "Body, UI, and paragraph typeface."
      },
      "serif": {
        "$value": ["Space Grotesk", "sans-serif"],
        "$description": "The display role is carried here for template compatibility; use it for large editorial headings."
      },
      "mono": {
        "$value": ["Space Mono", "monospace"],
        "$description": "Eyebrows, navigation metadata, terminal copy, and compact labels."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.375rem",
      "$description": "Small, tactile corner treatment. Avoid pill-shaped UI except for status dots."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel base rhythm; larger layout gaps build from this step."
    }
  }
}