<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Serve the standalone landing pages before the main site's SPA fallback.
  RewriteRule ^(academy-landing|vip)/?$ $1/index.html [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
